// ===== ШАБЛОН totp_secrets.h =====
// 1. Скопируй этот файл в totp_secrets.h (в этой же папке).
// 2. Впиши свои аккаунты: имя + base32-секрет.
//    (значения бери из вывода unpack_migration.py: "issuer — name" и "secret (base32)")
// 3. Файл totp_secrets.h уже в .gitignore — в репозиторий не попадёт.
//
// Формат каждой строки: { "Название", "BASE32_СЕКРЕТ" },

struct TotpEntry {
  const char *name;
  const char *secret; // base32
};

TotpEntry totpEntries[] = {
  { "Google: user@example.com", "JBSWY3DPEHPK3PXP" },
  { "GitHub: username",         "GEZDGNBVGY3TQOJQ" },
  // добавь свои строки ниже (и удали примеры выше)
};

const int TOTP_COUNT = sizeof(totpEntries) / sizeof(totpEntries[0]);
